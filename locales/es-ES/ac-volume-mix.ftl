# Audoxidy (Teksilo UI): Audio Center: the volume and mix tab.
# Spanish: the Iced UI's strings, verbatim except the corrections listed in
# docs/teksilo-port-quirk-fixes.md (fix 15). A message the Iced UI does not
# have is marked `# Not in the Iced UI: <why>.`

## Volume fades
ac-volume-mix-fades-title = Desvanecimiento de Volumen
ac-volume-mix-smooth = Suavizar el cambio de volumen
ac-volume-mix-fade-in = Desvanecimiento de volumen al iniciar la canción
ac-volume-mix-fade-out = Desvanecimiento de volumen al terminar la canción

## Silence removal
ac-volume-mix-silence-title = Eliminar silencio
ac-volume-mix-silence-duration = Eliminar los silencios mayores a:
ac-volume-mix-silence-threshold = Umbral de eliminación de silencios menores a:
ac-volume-mix-silence-edges = Eliminar silencios de inicio y fin de las canciones

## Pre-amp
ac-volume-mix-preamp-title = Pre-Amplificador
ac-volume-mix-preamp-level = Nivel del Pre-Amplificador

## ReplayGain
ac-volume-mix-rg-title = Replay Gain
ac-volume-mix-rg-album = Usar valor de la etiqueta incrustada 'Album'
ac-volume-mix-rg-track = Usar valor de la etiqueta incrustada 'Canción'
ac-volume-mix-rg-untagged = Replay Gain fijo para canciones sin etiquetas

## Crossfade
ac-volume-mix-crossfade-title = Mezcla Cruzada
ac-volume-mix-crossfade-manual = Cambio manual:
ac-volume-mix-crossfade-auto = Cambio automático:
ac-volume-mix-crossfade-blend = Mezclar canción actual con la siguiente

## Accessible names of the steppers
# Not in the Iced UI: a stepper has no label of its own; the text beside it is a separate widget.
ac-volume-mix-fade-in-value = Duración del desvanecimiento al iniciar
# Not in the Iced UI: accessible name of the fade-out stepper.
ac-volume-mix-fade-out-value = Duración del desvanecimiento al terminar
# Not in the Iced UI: accessible name of the shortest-silence stepper.
ac-volume-mix-silence-duration-value = Silencio más corto eliminado
# Not in the Iced UI: accessible name of the silence threshold stepper.
ac-volume-mix-silence-threshold-value = Umbral de silencio
# Not in the Iced UI: accessible name of the pre-amplifier stepper.
ac-volume-mix-preamp-value = Ganancia del Pre-Amplificador
# Not in the Iced UI: accessible name of the album ReplayGain offset stepper.
ac-volume-mix-rg-album-value = Ajuste de Replay Gain de álbum
# Not in the Iced UI: accessible name of the song ReplayGain offset stepper.
ac-volume-mix-rg-track-value = Ajuste de Replay Gain de canción
# Not in the Iced UI: accessible name of the untagged-songs ReplayGain stepper.
ac-volume-mix-rg-untagged-value = Replay Gain de canciones sin etiquetas
# Not in the Iced UI: accessible name of the manual crossfade stepper (its label is shared with the automatic one).
ac-volume-mix-crossfade-manual-value = Duración de la mezcla manual
# Not in the Iced UI: accessible name of the automatic crossfade stepper.
ac-volume-mix-crossfade-auto-value = Duración de la mezcla automática
