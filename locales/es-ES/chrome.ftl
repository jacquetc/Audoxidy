# Audoxidy (Teksilo UI): The shared widget chrome: menus, search fields, column headers, album art, dialog frames.
# Spanish: the Iced UI's strings, verbatim except the corrections listed in
# docs/teksilo-port-quirk-fixes.md (fix 15). A message the Iced UI does not
# have is marked `# Not in the Iced UI: <why>.`

## Search field
# Not in the Iced UI: accessible name of the "x" that empties a search field.
chrome-search-clear = Borrar búsqueda

## Dialogs
chrome-dialog-cancel = Cancelar

## Column header
# Not in the Iced UI: accessible name of the header row.
chrome-column-headers = Encabezados de columna
chrome-column-title = Título
chrome-column-artist = Artista
chrome-column-album-artist = Artista del Álbum
chrome-column-album = Álbum
chrome-column-genre = Género
chrome-column-year = Año
chrome-column-duration = Duración
chrome-column-format = Formato
chrome-column-sample-rate = Muestreo
chrome-column-channels = Canales
chrome-column-bit-depth = Profundidad
chrome-column-bitrate = Bits
chrome-column-size = Tamaño
chrome-column-album-card = Tarjeta de álbum
# Not in the Iced UI: the thumbnail column's header is empty; this is its accessible name.
chrome-column-cover = Carátula
# Not in the Iced UI: accessible name of a column's resize grip.
chrome-column-resize = Redimensionar { $column }
# Not in the Iced UI: assistive-technology action that widens a column.
chrome-column-widen = Ensanchar columna
# Not in the Iced UI: assistive-technology action that narrows a column.
chrome-column-narrow = Estrechar columna
# Not in the Iced UI: announced after a keyboard or assistive-technology resize.
chrome-column-width = { $column }: { $width } px
