# Audoxidy (Teksilo UI): Audio Center: the volume and mix tab.
# Source locale: `tr!` validates keys against these files.

## Volume fades
ac-volume-mix-fades-title = Volume Fading
ac-volume-mix-smooth = Smooth volume changes
ac-volume-mix-fade-in = Fade volume in when a song starts
ac-volume-mix-fade-out = Fade volume out when a song ends

## Silence removal
ac-volume-mix-silence-title = Remove silence
ac-volume-mix-silence-duration = Remove silences longer than:
ac-volume-mix-silence-threshold = Threshold for removing silences quieter than:
ac-volume-mix-silence-edges = Remove silence at the start and end of songs

## Pre-amp
ac-volume-mix-preamp-title = Pre-Amplifier
ac-volume-mix-preamp-level = Pre-Amplifier level

## ReplayGain
ac-volume-mix-rg-title = Replay Gain
ac-volume-mix-rg-album = Use the embedded 'Album' tag value
ac-volume-mix-rg-track = Use the embedded 'Song' tag value
ac-volume-mix-rg-untagged = Fixed Replay Gain for songs without tags

## Crossfade
ac-volume-mix-crossfade-title = Crossfade
ac-volume-mix-crossfade-manual = Manual change:
ac-volume-mix-crossfade-auto = Automatic change:
ac-volume-mix-crossfade-blend = Blend the current song with the next

## Accessible names of the steppers
ac-volume-mix-fade-in-value = Fade-in length
ac-volume-mix-fade-out-value = Fade-out length
ac-volume-mix-silence-duration-value = Shortest silence removed
ac-volume-mix-silence-threshold-value = Silence threshold
ac-volume-mix-preamp-value = Pre-Amplifier gain
ac-volume-mix-rg-album-value = Album Replay Gain offset
ac-volume-mix-rg-track-value = Song Replay Gain offset
ac-volume-mix-rg-untagged-value = Replay Gain for songs without tags
ac-volume-mix-crossfade-manual-value = Manual crossfade length
ac-volume-mix-crossfade-auto-value = Automatic crossfade length
