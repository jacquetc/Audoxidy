# Audoxidy (Teksilo UI): The value controls shared by panels: sliders, steppers, the VU meter.
# Source locale: `tr!` validates keys against these files.

## Sliders and steppers
# The accessible action that does what a secondary click on a slider or a
# stepper does.
controls-reset-default = Reset to default
# The equalizer's value bubble: the gain with one decimal (the Iced UI's
# `{:.1} dB`).
controls-eq-value = { $value } dB

## VU meter
# The words drawn on the meter (the Iced UI draws them in English).
controls-meter-left = L
controls-meter-right = R
controls-meter-mid = M
controls-meter-side = S
controls-meter-peak = Pk
controls-meter-rms = Rms
controls-meter-crest = Crest
# The meter's accessible name, and the words of its accessible value
# ("L -12 dB, R -11 dB").
controls-meter-name = VU meter
controls-meter-db = { $value } dB
controls-meter-silent = silent
