# Audoxidy (Teksilo UI): The playlist panel (tabs, rows, menus, bottom bar).
# Source locale: `tr!` validates keys against these files.

## Toasts
# A successful export.
playlist-toast-exported = Playlist exported
playlist-toast-exported-partly = Playlist exported with errors
playlist-toast-copies-failed =
    { $count ->
        [one] { $count } song could not be copied
       *[other] { $count } songs could not be copied
    }
playlist-toast-export-failed = The playlist could not be exported
playlist-toast-import-failed = The playlist could not be imported
playlist-toast-add-failed = The files could not be added
playlist-toast-create-failed = The playlist could not be created
playlist-toast-rename-failed = The playlist could not be renamed
playlist-toast-delete-failed = The playlist could not be deleted
playlist-toast-location-failed = The file's location could not be opened

